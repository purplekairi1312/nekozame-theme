{
  "name": "nekozame",
  "type": "dark",
  "colors": {
    "editor.background": "#5a4f6e",
    "editor.foreground": "#ffffff",
    "editorLineNumber.foreground": "#a094b8",
    "editorLineNumber.activeForeground": "#ffd4ee",
    "editorCursor.foreground": "#ffc0e5",
    "editor.selectionBackground": "#7c6a9a",
    "editor.lineHighlightBackground": "#685c7f80",
    "editorIndentGuide.background1": "#685c7f",
    "editor.findMatchBackground": "#ffc0e570",
    "editor.findMatchHighlightBackground": "#ffc0e535",
    "editorBracketMatch.background": "#8a76a8",
    "editorBracketMatch.border": "#ffd1ec",
    "editorGutter.addedBackground": "#c8f7dc",
    "editorGutter.modifiedBackground": "#b8e4ff",
    "editorGutter.deletedBackground": "#ffc0d2",
    "editorError.foreground": "#ffb3c8",
    "editorWarning.foreground": "#fff1b0",
    "editorInfo.foreground": "#b8e4ff",
    "sideBar.background": "#4f4562",
    "sideBar.foreground": "#e8def5",
    "sideBarSectionHeader.background": "#4f4562",
    "sideBarTitle.foreground": "#ffd4ee",
    "activityBar.background": "#433a55",
    "activityBar.foreground": "#ffc0e5",
    "activityBar.inactiveForeground": "#b3a7cb",
    "activityBarBadge.background": "#ffc0e5",
    "activityBarBadge.foreground": "#433a55",
    "titleBar.activeBackground": "#433a55",
    "titleBar.activeForeground": "#ffd4ee",
    "titleBar.inactiveBackground": "#433a55",
    "titleBar.inactiveForeground": "#b3a7cb",
    "statusBar.background": "#685c7f",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#685c7f",
    "statusBarItem.remoteBackground": "#ffc0e5",
    "statusBarItem.remoteForeground": "#433a55",
    "tab.activeBackground": "#5a4f6e",
    "tab.inactiveBackground": "#4f4562",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#d8cdec",
    "tab.activeBorderTop": "#ffc0e5",
    "editorGroupHeader.tabsBackground": "#4f4562",
    "panel.background": "#4f4562",
    "panel.border": "#685c7f",
    "terminal.background": "#5a4f6e",
    "list.activeSelectionBackground": "#8a76a8",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#7c6a9a",
    "list.hoverBackground": "#685c7f",
    "list.highlightForeground": "#ffc0e5",
    "focusBorder": "#ffd1ec",
    "input.background": "#433a55",
    "input.foreground": "#ffffff",
    "input.border": "#685c7f",
    "dropdown.background": "#4f4562",
    "button.background": "#ffc0e5",
    "button.foreground": "#433a55",
    "button.hoverBackground": "#ffd4ee",
    "badge.background": "#ffc0e5",
    "badge.foreground": "#433a55",
    "textLink.foreground": "#ffc6ea",
    "scrollbarSlider.background": "#8a76a880",
    "editorWidget.background": "#4f4562",
    "quickInput.background": "#4f4562",
    "quickInputList.focusBackground": "#8a76a8",
    "menu.background": "#4f4562",
    "menu.selectionBackground": "#8a76a8",
    "terminal.ansiBlack": "#433a55",
    "terminal.ansiRed": "#ffb3c8",
    "terminal.ansiGreen": "#dcf8bc",
    "terminal.ansiYellow": "#fff1b0",
    "terminal.ansiBlue": "#b8e4ff",
    "terminal.ansiMagenta": "#ffc0e5",
    "terminal.ansiCyan": "#b8f5f2",
    "terminal.ansiWhite": "#ffd4ee",
    "terminal.ansiBrightBlack": "#d9b8d6",
    "terminal.ansiBrightRed": "#ffcadb",
    "terminal.ansiBrightGreen": "#c8f7dc",
    "terminal.ansiBrightYellow": "#fff7cf",
    "terminal.ansiBrightBlue": "#d6efff",
    "terminal.ansiBrightMagenta": "#ffd4ee",
    "terminal.ansiBrightCyan": "#d6fbf8",
    "terminal.ansiBrightWhite": "#ffe6f4"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d8cdec",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ffc0e5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#b8e4ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e3ccff"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#c8f7dc"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fff1b0"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffd2b8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f1e6ff"
      }
    },
    {
      "scope": [
        "support.variable",
        "variable.language",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ffd4ee"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#f1e6ff"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#ffc0e5"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffc0e5"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e3ccff"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffc0e5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ffd2b8"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ffb3c8"
      }
    }
  ]
}
