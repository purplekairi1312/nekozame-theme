; nekozame for kvantum (qt apps). generated from palette.toml by generate.py;
; edit the palette there. nekozame.svg next to it is drawn by generate.py too.
; goes in ~/.config/Kvantum/nekozame/, then kvantummanager --set nekozame

[%General]
author=purplekairi1312
comment=nekozame: soft violet-gray with pastel pink
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=false
splitter_width=7
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=6
slider_handle_width=16
slider_handle_length=16
check_size=16
toolbar_icon_size=16
animate_states=true
transient_scrollbar=false
respect_DE=true

[GeneralColors]
window.color=#4f4562
base.color=#5a4f6e
alt.base.color=#62577a
button.color=#685c7f
light.color=#7c6a9a
mid.light.color=#8a76a8
dark.color=#433a55
mid.color=#4f4562
highlight.color=#ffc0e5
inactive.highlight.color=#8a76a8
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#b3a7cb
tooltip.text.color=#ffffff
highlight.text.color=#433a55
link.color=#b8e4ff
link.visited.color=#e3ccff
progress.indicator.text.color=#ffffff

[Hacks]
respect_darkness=true
transparent_ktitle_label=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#433a55
text.disabled.color=#b3a7cb
text.shadow=0
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4
text.iconspacing=4

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.toggle.color=#ffffff

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color=#ffffff

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color=#ffffff

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=3
text.margin.right=3

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow
text.toggle.color=#ffffff

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.normal.color=#e8def5
text.focus.color=#ffffff
text.toggle.color=#433a55
text.margin.left=8
text.margin.right=8
text.margin.top=3
text.margin.bottom=3
min_height=2.0font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=2
text.margin.bottom=2

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=12

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=1
text.focus.color=#ffffff
text.press.color=#433a55
text.toggle.color=#433a55

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=grip
indicator.size=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color=#433a55
text.press.color=#433a55
text.toggle.color=#433a55
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.left=6
text.margin.right=6
text.focus.color=#433a55
text.press.color=#433a55
text.toggle.color=#433a55

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.element=mdi
indicator.size=12
text.bold=true

[GroupBox]
inherits=GenericFrame
frame.element=group
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=2

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
