{
  "enabled": true,
  "detectDarkTheme": false,
  "disabledFor": ["github.com", "youtube.com", "www.youtube.com", "m.youtube.com"],
  "theme": {
    "mode": 1,
    "brightness": 100,
    "contrast": 100,
    "grayscale": 0,
    "sepia": 0,
    "darkSchemeBackgroundColor": "{{bg}}",
    "darkSchemeTextColor": "{{pinktext}}",
    "lightSchemeBackgroundColor": "{{softwhite}}",
    "lightSchemeTextColor": "{{deep}}",
    "scrollbarColor": "{{selection}}",
    "selectionColor": "{{orchid}}",
    "styleSystemControls": true
  }
}
