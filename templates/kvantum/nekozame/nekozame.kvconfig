; nekozame for kvantum (qt apps). generated from palette.toml by generate.py;
; edit the palette there. nekozame.svg next to it is drawn by generate.py too.
; goes in ~/.config/Kvantum/nekozame/, then kvantummanager --set nekozame

[%General]
author=purplekairi1312
comment=nekozame: soft violet-gray with pastel pink
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=false
splitter_width=7
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=6
slider_handle_width=16
slider_handle_length=16
check_size=16
toolbar_icon_size=16
animate_states=true
transient_scrollbar=false
respect_DE=true

[GeneralColors]
window.color={{panel}}
base.color={{bg}}
alt.base.color=#62577a
button.color={{raised}}
light.color={{region}}
mid.light.color={{selection}}
dark.color={{deep}}
mid.color={{panel}}
highlight.color={{orchid}}
inactive.highlight.color={{selection}}
text.color={{fg}}
window.text.color={{fg}}
button.text.color={{fg}}
disabled.text.color={{dim}}
tooltip.text.color={{fg}}
highlight.text.color={{deep}}
link.color={{blue}}
link.visited.color={{violet}}
progress.indicator.text.color={{fg}}

[Hacks]
respect_darkness=true
transparent_ktitle_label=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{deep}}
text.disabled.color={{dim}}
text.shadow=0
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4
text.iconspacing=4

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.toggle.color={{fg}}

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color={{fg}}

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color={{fg}}

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=3
text.margin.right=3

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow
text.toggle.color={{fg}}

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.normal.color={{muted}}
text.focus.color={{fg}}
text.toggle.color={{deep}}
text.margin.left=8
text.margin.right=8
text.margin.top=3
text.margin.bottom=3
min_height=2.0font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=2
text.margin.bottom=2

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=12

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=1
text.focus.color={{fg}}
text.press.color={{deep}}
text.toggle.color={{deep}}

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=grip
indicator.size=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color={{deep}}
text.press.color={{deep}}
text.toggle.color={{deep}}
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.left=6
text.margin.right=6
text.focus.color={{deep}}
text.press.color={{deep}}
text.toggle.color={{deep}}

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.element=mdi
indicator.size=12
text.bold=true

[GroupBox]
inherits=GenericFrame
frame.element=group
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=2

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
