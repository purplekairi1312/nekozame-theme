// nekozame for bitwig studio 6.1.7 (bitwig theme editor 2.4.0), purplekairi1312
// only overrides are listed; everything else stays bitwig's default.
// its shades are tuned by hand for bitwig, so generate.py leaves this file as is.
Gradient: true

